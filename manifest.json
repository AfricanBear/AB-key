{
  "manifest_version": 3,
  "name": "AB-key",
  "version": "0.4.1",
  "description": "Hotkey-based click automation for complex and dynamic elements.",
  "permissions": ["storage", "activeTab", "scripting"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "src/background/service-worker.js",
    "type": "module"
  },
  "options_page": "src/options/options.html",
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["src/content/content-script.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://app.abacum.io/*"],
      "js": ["src/content/abacum-tab-title.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["*://*.abacum.io/*"],
      "js": ["src/content/abacum-light-nav.js"],
      "run_at": "document_idle"
    }
  ],
  "commands": {
    "run_primary_action": {
      "suggested_key": {
        "default": "Ctrl+Shift+Y"
      },
      "description": "Execute the primary configured automation action"
    },
    "run_secondary_action": {
      "suggested_key": {
        "default": "Ctrl+Shift+U"
      },
      "description": "Execute the secondary configured automation action"
    }
  },
  "icons": {
    "16": "assets/icons/ab-key.png",
    "32": "assets/icons/ab-key.png",
    "48": "assets/icons/ab-key.png",
    "128": "assets/icons/ab-key.png"
  },
  "action": {
    "default_title": "AB-key",
    "default_popup": "src/popup/popup.html",
    "default_icon": {
      "16": "assets/icons/ab-key.png",
      "32": "assets/icons/ab-key.png"
    }
  }
}
