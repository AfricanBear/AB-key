{
  "manifest_version": 3,
  "name": "AB-key",
  "version": "0.10.0",
  "description": "Hotkey-based click automation for complex and dynamic elements.",
  "permissions": ["storage", "activeTab", "scripting"],
  "host_permissions": ["*://*.abacum.io/*"],
  "background": {
    "service_worker": "src/background/service-worker.js",
    "type": "module"
  },
  "options_page": "src/options/options.html",
  "content_scripts": [
    {
      "matches": ["*://*.abacum.io/*"],
      "js": ["src/content/toolbar-rail.js", "src/content/sidebar-nav.js", "src/content/content-script.js", "src/content/ab-key-panel-host.js"],
      "css": ["src/content/ab-key-panel-host.css"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://app.abacum.io/*"],
      "js": ["src/content/abacum-tab-title.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["*://*.abacum.io/*"],
      "js": ["src/content/abacum-light-nav.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["*://*.abacum.io/*"],
      "js": ["src/content/abacum-darker-values.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["*://*.abacum.io/*"],
      "js": ["src/content/abacum-dataset-range-sum.js"],
      "run_at": "document_idle"
    }
  ],
  "commands": {
    "run_primary_action": {
      "description": "Execute the primary configured automation action (unbound by default)"
    }
  },
  "icons": {
    "16": "assets/icons/ab-key.png",
    "32": "assets/icons/ab-key.png",
    "48": "assets/icons/ab-key.png",
    "128": "assets/icons/ab-key.png"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "src/popup/popup.html",
        "src/popup/popup.css",
        "src/popup/popup.js",
        "src/shared/config-schema.js",
        "src/shared/errors.js"
      ],
      "matches": ["<all_urls>"]
    }
  ],
  "action": {
    "default_title": "A+B key",
    "default_icon": {
      "16": "assets/icons/ab-key.png",
      "32": "assets/icons/ab-key.png"
    }
  }
}
